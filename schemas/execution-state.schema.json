{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature execution state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "state",
    "branch",
    "pull_request",
    "promotion_mode",
    "prd_approved_at",
    "active_slice",
    "repair_attempts",
    "last_updated",
    "blocker",
    "slices"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "spec_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "state": {
      "enum": [
        "draft",
        "ready",
        "planning",
        "executing",
        "verifying",
        "promoting",
        "completed",
        "blocked"
      ]
    },
    "branch": {
      "type": "string",
      "pattern": "^feature/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pull_request": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "promotion_mode": {
      "enum": [
        "merge_when_green",
        "pr_ready_only",
        "plan_only"
      ]
    },
    "prd_approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_slice": {
      "type": [
        "string",
        "null"
      ]
    },
    "repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "last_updated": {
      "type": "string"
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ]
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$"
          },
          "state": {
            "enum": [
              "pending",
              "in_progress",
              "review",
              "completed",
              "blocked"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

