{
  "name": "AI-driven project",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    },
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "npm install --global @openai/codex @anthropic-ai/claude-code && python3 -m pip install --break-system-packages -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code"
      ]
    }
  }
}
